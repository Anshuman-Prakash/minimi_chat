# Copy to .env and fill in. You need ONE model key (Groq or Claude) plus the Tavily key.

# ---- Model: choose one ----

# Free option: Groq. Key at https://console.groq.com/keys (no card needed).
GROQ_API_KEY=

# Best quality: the Claude API. Key at https://platform.claude.com/ (prepaid credit).
# If both keys are set, Claude is used; LLM_PROVIDER below overrides that.
ANTHROPIC_API_KEY=

# ---- Search (required) ----

# Tavily: web search + page extraction. Free tier. Key at https://app.tavily.com/
TAVILY_API_KEY=

# ---- Optional ----
# LLM_PROVIDER=groq                  # groq | claude. Default: whichever key is set
# ANSWER_MODEL=                      # writes the answers. Default: openai/gpt-oss-120b (Groq), claude-sonnet-5-5 (Claude)
# FAST_MODEL=                        # planning, fact extraction, summaries. Default: openai/gpt-oss-20b (Groq), claude-haiku-5-5 (Claude)
# ANSWER_EFFORT=low                  # low | medium | high
# GROQ_BASE_URL=https://api.groq.com/openai/v1   # any OpenAI-compatible service works; set the two model names to match
# SEARCH_DEPTH=advanced              # fast | basic | advanced (Tavily; advanced returns page passages)
# SEARCH_MAX_RESULTS=5               # results per search; lower it if a free model plan rejects large requests
# PORT=3000
# DB_PATH=data/minimi.db             # SQLite file; created on first run
# DEFAULT_TZ=UTC                     # used only if the browser sends no timezone
# NOW_OVERRIDE=2026-11-18T10:00:00Z  # pretend "now" is this instant (testing date logic)
