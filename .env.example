# Copy to .env and fill in. Both keys are required.

# Anthropic API key (planner + answer models). https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Tavily API key (web search + page extraction). https://app.tavily.com/
TAVILY_API_KEY=

# ---- Optional ----
# ANSWER_MODEL=claude-sonnet-5-5     # writes the answers
# FAST_MODEL=claude-haiku-5-5        # planning, claim extraction, summaries
# ANSWER_EFFORT=low                  # low | medium | high
# SEARCH_DEPTH=advanced              # fast | basic | advanced (Tavily; advanced returns page passages)
# PORT=3000
# DEFAULT_TZ=UTC                     # used only if the browser sends no timezone
# NOW_OVERRIDE=2026-11-18T10:00:00Z  # pretend "now" is this instant (testing date logic)
